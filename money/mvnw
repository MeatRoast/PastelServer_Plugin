#!/bin/sh
set -e

APP_HOME=$(cd "${0%/*}" && pwd -P)
WRAPPER_JAR="$APP_HOME/.mvn/wrapper/maven-wrapper.jar"

if ! command -v java >/dev/null 2>&1; then
  echo "Error: Java not found in PATH."
  exit 1
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Error: $WRAPPER_JAR not found."
  echo "Run once with internet access to download wrapper jar."
  exit 1
fi

exec java -classpath "$WRAPPER_JAR" "-Dmaven.multiModuleProjectDirectory=$APP_HOME" org.apache.maven.wrapper.MavenWrapperMain "$@"
